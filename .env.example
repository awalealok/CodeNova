# Copy this file to .env and change all secrets before deployment.
POSTGRES_DB=inkloom_db
POSTGRES_USER=inkloom_user
POSTGRES_PASSWORD=change_this_database_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
APP_ENV=development
DEMO_AUTH_MODE=false
INKLOOM_SECRET_KEY=replace_with_a_long_random_secret_at_least_32_characters
ACCESS_TOKEN_MINUTES=720
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional: use a hosted PostgreSQL connection URL instead of POSTGRES_* variables.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/inkloom_db

# Round 2 AI review (OpenAI-compatible Chat Completions API)
# Leave LLM_API_KEY blank to run deterministic-only mode.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=45

# Vector RAG uses a separate OpenAI-compatible embedding credential.
# Leave blank to explicitly disable AI review while vector embeddings are unavailable.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_TIMEOUT_SECONDS=30
RAG_MIN_SIMILARITY=0.62

# Password reset email. Recovery endpoints remain disabled until these are configured.
FRONTEND_BASE_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=10
